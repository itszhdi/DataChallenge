# Ссылка организаторов БЕЗ &group_id в конце (бэкенд дописывает его сам)
DATASET_API_URL=https://example.powerplatform.com/...invoke?api-version=1&sp=...&sv=1.0&sig=SECRET

# --- Gemini (бесплатный тариф) ---
LLM_PROVIDER=gemini
LLM_API_KEY=your-ai-studio-key
LLM_MODEL=gemini-3.6-flash
# Optional overrides. Voice calls remain excluded by default; remove them from EXCLUDE_CHANNELS to enable.
LLM_CHAT_MODEL=
LLM_CALL_MODEL=
LLM_REASONING_EFFORT=low
LLM_MIN_INTERVAL_SEC=7
LLM_CONCURRENCY=1
LLM_RETRIES=2
EXCLUDE_CHANNELS=["voice call"]

# --- LM Studio / локальная модель Qwen 3.5 9B (раскомментировать вместо блока Gemini) ---
# Имя модели должно совпадать с идентификатором в LM Studio
# LLM_PROVIDER=openai
# LLM_BASE_URL=http://localhost:1234/v1
# LLM_API_KEY=lm-studio
# LLM_MODEL=qwen3.5-9b
# LLM_REASONING_EFFORT=
# LLM_TIMEOUT_SEC=600
# EXCLUDE_CHANNELS=[]

# Цены paid tier за 1M токенов [input, output]. Gemini 3.6 Flash: $0.75 / $3.75 до 31.12.2026.
# Free tier фактически бесплатный; оставь LLM_PRICES пустым или задай [0, 0], чтобы показывать $0.
# LLM_PRICES={"gemini-3.6-flash": [0.75, 3.75]}

# Optional fallback after repeated 429s. Example local LM Studio endpoint; requires a loaded JSON-capable model.
# LLM_FALLBACK_PROVIDER=openai
# LLM_FALLBACK_BASE_URL=http://localhost:1234/v1
# LLM_FALLBACK_API_KEY=lm-studio
# LLM_FALLBACK_MODEL=qwen3-8b

# DB_PATH=./cqa.sqlite3
# LOG_LEVEL=INFO
