# Ссылка организаторов БЕЗ &group_id в конце (бэкенд дописывает его сам)
DATASET_API_URL=https://example.powerplatform.com/...invoke?api-version=1&sp=...&sv=1.0&sig=SECRET

# --- Gemini (бесплатный тариф) ---
LLM_PROVIDER=gemini
LLM_API_KEY=your-ai-studio-key
LLM_MODEL=gemini-3.6-flash
LLM_REASONING_EFFORT=low
LLM_MIN_INTERVAL_SEC=7
LLM_CONCURRENCY=1
LLM_RETRIES=2
EXCLUDE_CHANNELS=["voice call"]

# --- LM Studio / локальная модель (раскомментировать вместо блока Gemini) ---
# LLM_PROVIDER=openai
# LLM_BASE_URL=http://localhost:1234/v1
# LLM_API_KEY=lm-studio
# LLM_MODEL=qwen3-8b
# LLM_MIN_INTERVAL_SEC=0
# LLM_REASONING_EFFORT=
# EXCLUDE_CHANNELS=[]

# Цены $ за 1M токенов [input, output], если тариф платный
# LLM_PRICES={"gemini-3.6-flash": [0.3, 2.5]}

# DB_PATH=./cqa.sqlite3
# LOG_LEVEL=INFO
