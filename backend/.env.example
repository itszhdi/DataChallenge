# Ссылка организаторов БЕЗ &group_id в конце (бэкенд дописывает его сам)
DATASET_API_URL=https://example.powerplatform.com/...invoke?api-version=1&sp=...&sv=1.0&sig=SECRET

# Название команды в results/<dev|prod>/results.json
# TEAM_NAME=Cyberpsychosis

# --- Gemini (бесплатный тариф) ---
LLM_PROVIDER=gemini
LLM_API_KEY=your-ai-studio-key
LLM_MODEL=gemini-3.6-flash
# Optional overrides. Voice calls remain excluded by default; remove them from EXCLUDE_CHANNELS to enable.
LLM_CHAT_MODEL=
LLM_CALL_MODEL=
LLM_REASONING_EFFORT=low
LLM_MIN_INTERVAL_SEC=7
LLM_CONCURRENCY=1
LLM_RETRIES=2
# Каналы, которые не отправляются в модель (пусто — все разрешены)
EXCLUDE_CHANNELS=[]

# --- GPT-6 Luna (OpenAI API) — профиль luna, включается в UI или make use-luna ---
LUNA_API_KEY=
# LUNA_MODEL=gpt-6-luna
# LUNA_BASE_URL=https://api.openai.com/v1
# Если API отклонит значение, поменяй здесь: none | low | medium | high
# LUNA_REASONING_EFFORT=low
# LUNA_CONCURRENCY=3
# LUNA_MIN_INTERVAL_SEC=0
# LUNA_TIMEOUT_SEC=180

# --- Распознавание звонков (Gemini, тот же LLM_API_KEY) ---
# Выключено: звонки оцениваются по транскрипту из датасета. true — включить распознавание записей
# TRANSCRIBE_ENABLED=false
# TRANSCRIBE_MODEL=gemini-3.8-flash
# TRANSCRIBE_REASONING_EFFORT=low
# TRANSCRIBE_TIMEOUT_SEC=600
# TRANSCRIBE_MAX_AUDIO_MB=20

# --- Локальная модель через Ollama — второй профиль, включается в UI/PATCH /api/settings {"llm_profile":"local"} ---
# ! Ollama через OpenAI-совместимый адрес не принимает размер контекста, а по умолчанию он ~4k: промпт оценки (~9–11k токенов)
# ! молча обрезается. Создайте вариант модели с контекстом 16k:
#     printf 'FROM qwen2.5:7b\nPARAMETER num_ctx 16384\n' > Modelfile && ollama create qwen2.5:7b-cqa -f Modelfile
# В Docker запускайте через make docker-up-ollama (сеть хоста), иначе контейнер не видит Ollama на localhost.
# LOCAL_LLM_BASE_URL=http://localhost:11434/v1
# LOCAL_LLM_MODEL=qwen2.5:7b-cqa
# LOCAL_LLM_API_KEY=ollama
# LOCAL_LLM_TIMEOUT_SEC=600

# --- Локальная модель (LM Studio) — второй профиль, включается в UI/PATCH /api/settings {"llm_profile":"local"} ---
LOCAL_LLM_BASE_URL=http://localhost:1234/v1
LOCAL_LLM_MODEL=qwen/qwen3.5-9b
# LOCAL_LLM_API_KEY=lm-studio
# ! none — отключает «размышления» Qwen3.5 (иначе тысячи токенов до JSON); единственный способ, который понимает LM Studio
# LOCAL_LLM_REASONING_EFFORT=none
# LOCAL_LLM_MAX_TOKENS=3000
# LOCAL_LLM_MIN_INTERVAL_SEC=0
# LOCAL_LLM_CONCURRENCY=1
# LOCAL_LLM_TIMEOUT_SEC=600
# Профиль при первом запуске (дальше хранится в БД): gemini | luna | local
# DEFAULT_LLM_PROFILE=gemini

# Цены paid tier за 1M токенов [input, output]. Gemini 3.6 Flash: $0.75 / $3.75 до 31.12.2026.
# Free tier фактически бесплатный; оставь LLM_PRICES пустым или задай [0, 0], чтобы показывать $0.
# LLM_PRICES={"gemini-3.6-flash": [0.75, 3.75], "gpt-6-luna": [0.10, 0.50]}

# Optional fallback after repeated 429s. Example local LM Studio endpoint; requires a loaded JSON-capable model.
# LLM_FALLBACK_PROVIDER=openai
# LLM_FALLBACK_BASE_URL=http://localhost:1234/v1
# LLM_FALLBACK_API_KEY=lm-studio
# LLM_FALLBACK_MODEL=qwen3-8b

# DB_PATH=./cqa.sqlite3
# LOG_LEVEL=INFO
