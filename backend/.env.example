# Ссылка организаторов БЕЗ &group_id в конце (бэкенд дописывает его сам)
DATASET_API_URL=https://example.powerplatform.com/...invoke?api-version=1&sp=...&sv=1.0&sig=SECRET

# --- Gemini (бесплатный тариф) ---
LLM_PROVIDER=gemini
LLM_API_KEY=your-ai-studio-key
LLM_MODEL=gemini-3.6-flash
LLM_REASONING_EFFORT=low
LLM_MIN_INTERVAL_SEC=7
LLM_CONCURRENCY=1
LLM_RETRIES=2
# Каналы, которые не отправляются в модель (пусто — все разрешены)
EXCLUDE_CHANNELS=[]

# --- Распознавание звонков (Gemini, тот же LLM_API_KEY) ---
# TRANSCRIBE_MODEL=gemini-3.8-flash
# TRANSCRIBE_REASONING_EFFORT=low
# TRANSCRIBE_TIMEOUT_SEC=600
# TRANSCRIBE_MAX_AUDIO_MB=20

# --- Локальная модель (LM Studio) — второй профиль, включается в UI/PATCH /api/settings {"llm_profile":"local"} ---
LOCAL_LLM_BASE_URL=http://localhost:1234/v1
LOCAL_LLM_MODEL=qwen/qwen3.5-9b
# LOCAL_LLM_API_KEY=lm-studio
# ! none — отключает «размышления» Qwen3.5 (иначе тысячи токенов до JSON); единственный способ, который понимает LM Studio
# LOCAL_LLM_REASONING_EFFORT=none
# LOCAL_LLM_MAX_TOKENS=3000
# LOCAL_LLM_MIN_INTERVAL_SEC=0
# LOCAL_LLM_CONCURRENCY=1
# LOCAL_LLM_TIMEOUT_SEC=600
# Профиль при первом запуске (дальше хранится в БД): gemini | local
# DEFAULT_LLM_PROFILE=gemini

# Цены $ за 1M токенов [input, output], если тариф платный
# LLM_PRICES={"gemini-3.6-flash": [0.3, 2.5]}

# DB_PATH=./cqa.sqlite3
# LOG_LEVEL=INFO
